# PostgreSQL connection
DB_HOST=localhost
DB_PORT=5432
DB_NAME=epicevents_db
DB_USER=epicevents_user
DB_PASSWORD=change-me

# JWT authentication
# Generate with: openssl rand -base64 32
JWT_SECRET=change-me
JWT_EXPIRATION_HOURS=8
# Sentry error reporting (optional, no-op if empty)
SENTRY_DSN=
# Génération : python -c "import secrets; print(secrets.token_hex(16))"
ENCRYPTION_KEY=
